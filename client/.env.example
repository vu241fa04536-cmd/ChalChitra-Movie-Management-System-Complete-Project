# ==============================================================================
# CHALCHITRA CLIENT ENVIRONMENT CONFIGURATION (client/.env)
# ==============================================================================

# Backend API Base URL
#
# 1. Local Development:
#    Leave as '/api' so Vite forwards requests to the local backend on port 5000
VITE_API_URL=/api

# 2. Production Deployment (e.g. Vercel connecting to Render backend):
#    Set this to your live Render backend URL with the '/api' prefix:
# VITE_API_URL=https://your-backend-service.onrender.com/api
