{
  "name": "chalchitra-mern",
  "version": "2.0.0",
  "description": "ChalChitra - Full-Stack MERN Movie Management & Streaming System",
  "main": "server/server.js",
  "scripts": {
    "dev": "concurrently -k --prefix \"[{name}]\" --names \"SERVER,CLIENT\" --prefix-colors \"bgBlue.bold,bgMagenta.bold\" \"npm run server\" \"npm run client\"",
    "server": "npm --prefix server run dev",
    "client": "npm --prefix client run dev",
    "import:movies": "npm --prefix server run import:movies",
    "seed": "npm --prefix server run seed",
    "install:all": "npm install && npm --prefix server install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "keywords": [
    "mern",
    "mongodb",
    "express",
    "react",
    "node",
    "movie-management"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
