# ==============================================================================
# CHALCHITRA BACKEND ENVIRONMENT CONFIGURATION (server/.env)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB Atlas or Local MongoDB)
# For MongoDB Atlas (replace placeholders with your Atlas cluster details):
# MONGO_URI=mongodb+srv://<db_username>:<db_password>@cluster0.xxxxx.mongodb.net/chalchitra?retryWrites=true&w=majority&appName=Cluster0
# For Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/chalchitra

# Security & Authentication
# In production, use a strong random secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Administrator Credentials (Used to access the admin portal at /admin)
ADMIN_PASSWORD=your_secure_admin_password_here

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list of allowed frontend origins (e.g. Vercel deployment URL)
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# Optional DNS Resolver Override
# (Only needed if your host network blocks or fails SRV lookups with MongoDB Atlas)
# DNS_SERVERS=8.8.8.8,1.1.1.1
